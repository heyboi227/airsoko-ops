# Copy to .env. The .env file is git-ignored; never commit real secrets.

# --- Database -----------------------------------------------------------
# Matches docker-compose.yml. Port 5433 avoids colliding with any local
# Postgres already listening on 5432.
DATABASE_URL=postgres://airsoko:airsoko@localhost:5433/airsoko_ops

# --- API ----------------------------------------------------------------
API_PORT=4000
NODE_ENV=development

# Signing keys for access and refresh tokens. Development values only --
# generate real ones with `node -e "console.log(crypto.randomUUID())"` or
# equivalent before running anywhere that is not a laptop.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Seed ---------------------------------------------------------------
# Fixed seed keeps demo data byte-identical across machines and reruns.
SEED=airsoko-2026
# Entries made through the application are recorded as seed data under
# apps/api/src/db/seed/recorded and replayed by `npm run db:seed` and when the
# API starts, so two machines sharing this repository share the data. On by
# default in development, off everywhere else; "off" disables both.
# SEED_RECORDING=on

# --- Live telemetry -----------------------------------------------------
# "simulation" drives aircraft from the local flight schedule.
# Swap for a real provider without touching the UI.
TELEMETRY_PROVIDER=simulation
TELEMETRY_TICK_MS=2000

# --- Web ----------------------------------------------------------------
# Not Vite's default 5173, which collides with other tooling often enough to
# be a nuisance. The API's WEB_ORIGIN must agree with whatever this says.
WEB_PORT=5273
VITE_API_URL=http://localhost:4000
# Optional raster tile template. Left blank the map falls back to the
# bundled offline vector style, so the app works with no network at all.
VITE_MAP_TILE_URL=
